# GEMINI_API_KEY: Required for Gemini AI question extraction.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Discord OAuth2 Configuration (for real community Discord login & server membership verification)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID=""
DISCORD_REDIRECT_URI=""
ALLOWED_OAUTH_ORIGINS=""
DISCORD_SUPER_ADMIN_IDS=""

# Session Secret for signing HttpOnly auth cookies
SESSION_SECRET="change-this-in-production"

# Optional Multi-AI Provider & At-Rest Encryption Keys
# Admin can also configure/encrypt API keys directly in Admin -> AI Providers
OPENAI_API_KEY=""
AI_ENCRYPTION_KEY=""

